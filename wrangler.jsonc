{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "job-hunter-bot",
	"main": "src/worker.js",
	"compatibility_date": "2025-02-27",
	"compatibility_flags": [],
	"workers_dev": true,
	"build": {
		"command": "npm run build"
	},
	// Enable production log streaming via `wrangler tail`
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	// Cron triggers for 3 staggered batches per cycle
	// The batcher.js script maps:
	//   :00/:15/:30/:45 → Batch 0
	//   :05/:20/:35/:50 → Batch 1
	//   :10/:25/:40/:55 → Batch 2
	"triggers": {
		"crons": [
			// Fix 2: Staggered cron batches for distributed crawl workload
			// Batch 0: :00,:15,:30,:45 — high-priority sources
			"0,15,30,45 * * * *",
			// Batch 1: :05,:20,:35,:50 — medium-priority sources
			"5,20,35,50 * * * *",
			// Batch 2: :10,:25,:40,:55 — low-priority + exploration sources
			"10,25,40,55 * * * *"
		]
	},
	"kv_namespaces": [
		{
			"binding": "SEEN_JOBS",
			"id": "9606d0c7fcda4e69bb04cc351bd7fd5a"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "job-hunter-db",
			"database_id": "5ac7ed56-2edd-42ae-9ec8-28c8d57af629",
			"migrations_dir": "migrations"
		}
	],
	// Queue Producers (Worker can send messages TO these)
	"queues": {
		"producers": [
			{
				"queue": "feed-queue",
				"binding": "FEED_QUEUE"
			},
			{
				"queue": "job-queue",
				"binding": "JOB_QUEUE"
			},
			{
				"queue": "alert-queue",
				"binding": "ALERT_QUEUE"
			}
		],
		// Queue Consumers (Worker receives messages FROM these)
		"consumers": [
			{
				// Fix 4: Increased batch size from 5→10 to reduce worker overhead (8 invocations → 4)
				"queue": "feed-queue",
				"max_batch_size": 10,
				"max_batch_timeout": 2,
				"max_retries": 2
			},
			{
				"queue": "job-queue",
				"max_batch_size": 10,
				"max_batch_timeout": 2,
				"max_retries": 3
			},
			{
				"queue": "alert-queue",
				"max_batch_size": 10,
				"max_batch_timeout": 2,
				"max_retries": 5
			}
		]
	},
	// Workers AI for Semantic Embeddings (Task 7)
	"ai": {
		"binding": "AI"
	}
}